[Unit]
Description=RClone Google Drive Mount
Documentation=man:rclone(1)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive %h/.cache/rclone
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive \
    --config=%h/.config/rclone/rclone.conf \
    --vfs-cache-mode full \
    --vfs-cache-max-size 15G \
    --vfs-cache-max-age 24h \
    --vfs-write-back 15s \
    --drive-chunk-size 64M \
    --drive-upload-cutoff 64M \
    --tpslimit 10 \
    --tpslimit-burst 2 \
    --drive-pacer-min-sleep 10ms \
    --drive-pacer-burst 100 \
    --transfers 3 \
    --checkers 8 \
    --fast-list \
    --rc \
    --rc-addr=127.0.0.1:5572 \
    --rc-no-auth \
    --log-file=%h/.cache/rclone/rclone.log \
    --log-level=NOTICE
ExecStop=/usr/bin/fusermount -u %h/GoogleDrive
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
