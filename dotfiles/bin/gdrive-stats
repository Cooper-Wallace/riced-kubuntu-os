#!/usr/bin/env python3
"""
gdrive-stats - Visual TUI Dashboard for Rclone Google Drive Mount Telemetry.
Part of RKO (Riced Kubuntu OS).
"""

import argparse
import json
import os
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty
import urllib.error
import urllib.request
from datetime import datetime
from typing import Any, Dict, Optional

try:
    from rich import box
    from rich.align import Align
    from rich.console import Console
    from rich.layout import Layout
    from rich.live import Live
    from rich.panel import Panel
    from rich.progress import ProgressBar
    from rich.table import Table
    from rich.text import Text
except ImportError:
    print(
        "Error: 'rich' Python package is required. Install via: sudo apt install python3-rich",
        file=sys.stderr,
    )
    sys.exit(1)

# Default configuration
DEFAULT_RC_URL = "http://127.0.0.1:5572"
DEFAULT_INTERVAL = 1.0
SERVICE_NAME = "rclone-gdrive.service"
MOUNT_PATH = "~/GoogleDrive"

# Terminal state management for clean exit
_ORIGINAL_TERMIOS = None


def setup_terminal() -> None:
    global _ORIGINAL_TERMIOS
    if sys.stdin.isatty():
        try:
            _ORIGINAL_TERMIOS = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())
        except Exception:
            _ORIGINAL_TERMIOS = None


def restore_terminal() -> None:
    global _ORIGINAL_TERMIOS
    if _ORIGINAL_TERMIOS is not None and sys.stdin.isatty():
        try:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, _ORIGINAL_TERMIOS)
        except Exception:
            pass
        _ORIGINAL_TERMIOS = None

    # Drain any lingering characters in input buffer (prevent escape sequence leaks)
    if sys.stdin.isatty():
        try:
            while True:
                rlist, _, _ = select.select([sys.stdin], [], [], 0.01)
                if not rlist:
                    break
                os.read(sys.stdin.fileno(), 1024)
        except Exception:
            pass


def format_bytes(n: Optional[float]) -> str:
    if n is None or n < 0:
        return "0 B"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if abs(n) < 1024.0:
            return f"{n:3.1f} {unit}"
        n /= 1024.0
    return f"{n:.1f} PB"


def format_duration(seconds: Optional[float]) -> str:
    if seconds is None or seconds < 0:
        return "00:00:00"
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


def fetch_rc(endpoint: str, rc_url: str = DEFAULT_RC_URL, payload: Optional[Dict[str, Any]] = None, timeout: float = 1.2) -> Optional[Dict[str, Any]]:
    try:
        url = f"{rc_url.rstrip('/')}/{endpoint}"
        data = json.dumps(payload or {}).encode("utf-8")
        req = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None


def post_rc(endpoint: str, rc_url: str = DEFAULT_RC_URL, payload: Optional[Dict[str, Any]] = None, timeout: float = 2.0) -> bool:
    try:
        url = f"{rc_url.rstrip('/')}/{endpoint}"
        data = json.dumps(payload or {}).encode("utf-8")
        req = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return 200 <= resp.status < 300
    except Exception:
        return False


def get_mount_stats(mount_path: str = MOUNT_PATH) -> Optional[Any]:
    expanded = os.path.expanduser(mount_path)
    if not os.path.exists(expanded):
        return None
    try:
        return shutil.disk_usage(expanded)
    except Exception:
        return None


def get_systemd_status(service_name: str = SERVICE_NAME) -> str:
    try:
        res = subprocess.run(
            ["systemctl", "--user", "is-active", service_name],
            capture_output=True,
            text=True,
            timeout=1,
        )
        return res.stdout.strip()
    except Exception:
        return "unknown"


def get_key_non_blocking() -> Optional[str]:
    if not sys.stdin.isatty():
        return None
    try:
        rlist, _, _ = select.select([sys.stdin], [], [], 0)
        if rlist:
            ch = sys.stdin.read(1)
            if ch == "\x1b":  # escape sequence
                rlist2, _, _ = select.select([sys.stdin], [], [], 0.02)
                if rlist2:
                    ch += sys.stdin.read(2)
            return ch
    except Exception:
        return None
    return None


def build_help_overlay(width: int, height: int) -> Panel:
    table = Table(box=box.ROUNDED, expand=True, padding=(0, 2), border_style="#cba6f7")
    table.add_column("Key / Command", style="bold cyan", width=22)
    table.add_column("Action / Description", style="white")

    table.add_row("q / Esc / Ctrl+C", "Exit dashboard")
    table.add_row("r", "Force immediate telemetry refresh")
    table.add_row("f", "Drop & forget VFS directory cache (rclone rc vfs/forget)")
    table.add_row("c", "Reset transfer counters (rclone rc core/stats-reset)")
    table.add_row("s", "Attempt to restart systemd user service")
    table.add_row("? / h", "Toggle this help overlay")
    table.add_row("--once / -1", "Render single snapshot and exit cleanly")
    table.add_row("--json", "Dump complete telemetry data as JSON")
    table.add_row("-i <sec> / --interval", "Configure refresh poll rate (default 1.0s)")
    table.add_row(
        "[bold yellow]Google 403 Rate Limits[/bold yellow]",
        "[yellow]Default shared client ID is throttled globally. Configure a personal Google Cloud Client ID to stop backoffs.[/yellow]",
    )
    table.add_row(
        "[bold green]Camera SD Offloading[/bold green]",
        "[green]Run 'gdrive-import' for high-throughput streaming directly to cloud with checksum verification.[/green]",
    )

    return Panel(
        Align.center(table, vertical="middle"),
        title="[bold #cba6f7]⌨  Keybindings & Usage Guide[/bold #cba6f7]",
        subtitle="[dim]Press [bold cyan]?[/bold cyan], [bold cyan]h[/bold cyan], or [bold cyan]q[/bold cyan] to close[/dim]",
        box=box.DOUBLE,
        border_style="#cba6f7",
        padding=(1, 2),
    )


def build_offline_panel(rc_url: str, service_status: str, width: int) -> Panel:
    table = Table.grid(padding=(0, 1), expand=True)
    table.add_column(justify="center")

    title_text = Text.from_markup(
        f"\n[bold #f38ba8]⚠  Rclone Remote Control API Unreachable[/bold #f38ba8]\n"
        f"[dim]Endpoint: {rc_url}[/dim]\n"
    )
    table.add_row(title_text)

    status_badge = (
        "[bold green]● Active[/bold green]"
        if service_status == "active"
        else f"[bold red]● {service_status.capitalize()}[/bold red]"
    )
    table.add_row(Text.from_markup(f"Service ([cyan]{SERVICE_NAME}[/cyan]): {status_badge}\n"))

    info = Table(box=box.SIMPLE, show_header=False, padding=(0, 2))
    info.add_column(style="bold yellow", width=24)
    info.add_column(style="dim white")
    info.add_row("Start Service:", f"systemctl --user start {SERVICE_NAME}")
    info.add_row("Inspect Logs:", f"journalctl --user -u {SERVICE_NAME} -e")
    info.add_row("Verify Remote Config:", "rclone config")
    info.add_row("Test Direct Command:", f"rclone rc --url {rc_url} core/stats")

    table.add_row(Align.center(info))
    table.add_row(
        Text.from_markup(
            "\n[dim]Keys: [/dim][bold cyan][s][/bold cyan] [dim]Attempt Start Service  │  [/dim]"
            "[bold cyan][r][/bold cyan] [dim]Retry Connection  │  [/dim]"
            "[bold cyan][q][/bold cyan] [dim]Quit[/dim]"
        )
    )

    return Panel(
        Align.center(table, vertical="middle"),
        title="[bold #f38ba8]☁  Google Drive Diagnostics[/bold #f38ba8]",
        box=box.ROUNDED,
        border_style="#f38ba8",
        padding=(1, 2),
    )


def build_dashboard(
    console: Console,
    stats: Optional[Dict[str, Any]],
    vfs: Optional[Dict[str, Any]],
    transferred: Optional[Dict[str, Any]],
    memstats: Optional[Dict[str, Any]],
    version: Optional[Dict[str, Any]],
    bwlimit: Optional[Dict[str, Any]],
    options: Optional[Dict[str, Any]] = None,
    notification: Optional[str] = None,
    show_help: bool = False,
) -> Layout:
    width = console.width
    height = console.height

    if show_help:
        layout = Layout()
        layout.update(build_help_overlay(width, height))
        return layout

    is_wide = width >= 115

    layout = Layout()
    layout.split_column(
        Layout(name="header", size=3),
        Layout(name="summary", size=8 if is_wide else 9),
        Layout(name="transfers", ratio=2, minimum_size=5),
        Layout(name="bottom", ratio=2, minimum_size=6),
        Layout(name="footer", size=1),
    )

    # 1. Header & Rate Limit Detection
    status_str = get_systemd_status()
    if status_str == "active":
        status_badge = "[bold green]● Active[/bold green]"
    elif status_str == "inactive":
        status_badge = "[bold yellow]● Inactive[/bold yellow]"
    else:
        status_badge = f"[bold red]● {status_str.capitalize()}[/bold red]"

    # Detect Google Drive 403 rate limiting
    is_rate_limited = False
    last_err = stats.get("lastError", "") if stats else ""
    if any(k in last_err for k in ("403", "rateLimit", "RATE_LIMIT_EXCEEDED", "quota exceeded", "Quota exceeded")):
        is_rate_limited = True
    elif transferred:
        for t in transferred.get("transferred", []):
            err_msg = t.get("error", "")
            if any(k in err_msg for k in ("403", "rateLimit", "RATE_LIMIT_EXCEEDED", "quota exceeded", "Quota exceeded")):
                is_rate_limited = True
                break

    rate_limit_badge = " │ [bold red]⚠ THROTTLED (403 Rate Limit)[/bold red]" if is_rate_limited else ""

    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    if width >= 110:
        header_text = Text.from_markup(
            f"[bold #89b4fa]☁ Google Drive Monitor[/bold #89b4fa]  "
            f"[dim](gdrive-stats)[/dim]  │  "
            f"Remote: [cyan]gdrive:[/cyan]  │  "
            f"Mount: [cyan]{MOUNT_PATH}[/cyan]  │  "
            f"Service: {status_badge}"
            f"{rate_limit_badge}"
        )
    else:
        header_text = Text.from_markup(
            f"[bold #89b4fa]☁ GDrive[/bold #89b4fa] │ "
            f"Mount: [cyan]{MOUNT_PATH}[/cyan] │ "
            f"{status_badge}"
            f"{rate_limit_badge}"
        )
    time_text = Text.from_markup(f"[dim]{now_str}[/dim]")

    header_table = Table.grid(expand=True)
    header_table.add_column(justify="left", ratio=1)
    header_table.add_column(justify="right")
    header_table.add_row(header_text, time_text)
    layout["header"].update(Panel(header_table, box=box.ROUNDED, border_style="#89b4fa", padding=(0, 1)))

    # Metrics calculation
    speed = stats.get("speed", 0) if stats else 0
    total_bytes = stats.get("totalBytes", 0) if stats else 0
    uptime = format_duration(stats.get("elapsedTime", 0)) if stats else "00:00:00"
    transfers_done = stats.get("transfers", 0) if stats else 0
    checks = stats.get("checks", 0) if stats else 0
    deletes = stats.get("deletes", 0) if stats else 0
    renames = stats.get("renames", 0) if stats else 0

    disk_cache = vfs.get("diskCache", {}) if vfs else {}
    opt = vfs.get("opt", {}) if vfs else {}
    cache_used = disk_cache.get("bytesUsed", 0)
    cache_max = opt.get("CacheMaxSize", 10 * 1024**3)
    cache_pct = (cache_used / cache_max * 100) if cache_max > 0 else 0
    cache_files = disk_cache.get("files", 0)
    queued = disk_cache.get("uploadsQueued", 0)
    in_prog = disk_cache.get("uploadsInProgress", 0)
    writeback = opt.get("WriteBack", 5000000000) / 1e9

    mount_usage = get_mount_stats(MOUNT_PATH)
    meta_cache = vfs.get("metadataCache", {}) if vfs else {}

    # 2. Summary Layout
    if is_wide:
        layout["summary"].split_row(
            Layout(name="card_perf", ratio=1),
            Layout(name="card_cache", ratio=1),
            Layout(name="card_quota", ratio=1),
        )

        # Card 1: Performance
        perf_table = Table.grid(padding=(0, 1), expand=True)
        perf_table.add_column(style="dim", width=14, no_wrap=True)
        perf_table.add_column(style="bold", no_wrap=True)
        perf_speed_str = (
            f"[bold #a6e3a1]{format_bytes(speed)}/s[/bold #a6e3a1]"
            if speed > 0
            else "[dim]0 B/s (Idle)[/dim]"
        )
        perf_table.add_row("Transfer Speed:", perf_speed_str)
        perf_table.add_row("Transferred:", format_bytes(total_bytes))
        perf_table.add_row("Session Uptime:", uptime)
        perf_table.add_row("Completed:", f"{transfers_done} files")
        perf_table.add_row("Checks / Del:", f"{checks} / {deletes}")
        layout["card_perf"].update(
            Panel(perf_table, title="[bold #a6e3a1]⚡ Throughput & Session[/bold #a6e3a1]", box=box.ROUNDED, border_style="#a6e3a1")
        )

        # Card 2: Cache
        cache_table = Table.grid(padding=(0, 1), expand=True)
        cache_table.add_column(style="dim", width=14, no_wrap=True)
        cache_table.add_column(no_wrap=True)
        cache_table.add_row("Cache Usage:", f"{format_bytes(cache_used)} / {format_bytes(cache_max)} ({cache_pct:.1f}%)")
        cache_pbar = ProgressBar(total=100, completed=cache_pct, width=18, style="dim", complete_style="#fab387")
        cache_table.add_row("Cache Bar:", cache_pbar)
        cache_table.add_row("Local Files:", f"{cache_files} cached")
        q_str = f"[bold yellow]{queued} queued[/bold yellow]" if queued > 0 else "[dim]0 queued[/dim]"
        p_str = f"[bold cyan]{in_prog} active[/bold cyan]" if in_prog > 0 else "[dim]0 active[/dim]"
        cache_table.add_row("Pending Sync:", f"{q_str}, {p_str}")
        cache_table.add_row("Write-Back:", f"{writeback:.0f}s delay")
        layout["card_cache"].update(
            Panel(cache_table, title="[bold #fab387]💾 Local VFS Disk Cache[/bold #fab387]", box=box.ROUNDED, border_style="#fab387")
        )

        # Card 3: Remote Quota
        quota_table = Table.grid(padding=(0, 1), expand=True)
        quota_table.add_column(style="dim", width=14, no_wrap=True)
        quota_table.add_column(no_wrap=True)
        if mount_usage:
            gdrive_pct = (mount_usage.used / mount_usage.total * 100) if mount_usage.total > 0 else 0
            quota_table.add_row("Remote Quota:", f"{format_bytes(mount_usage.used)} / {format_bytes(mount_usage.total)}")
            quota_pbar = ProgressBar(total=100, completed=gdrive_pct, width=18, style="dim", complete_style="#cba6f7")
            quota_table.add_row("Usage Bar:", quota_pbar)
            quota_table.add_row("Free Space:", f"{format_bytes(mount_usage.free)} free ({100 - gdrive_pct:.1f}%)")
        else:
            quota_table.add_row("Remote Quota:", "[yellow]Mount offline[/yellow]")
            quota_table.add_row("Usage Bar:", "[dim]---[/dim]")
            quota_table.add_row("Free Space:", "[dim]---[/dim]")
        quota_table.add_row("Dir Cache:", f"{meta_cache.get('dirs', 0)} dirs, {meta_cache.get('files', 0)} files")
        poll_int = opt.get("PollInterval", 60000000000) / 1e9
        quota_table.add_row("Poll Interval:", f"{poll_int:.0f}s")
        layout["card_quota"].update(
            Panel(quota_table, title="[bold #cba6f7]☁ Remote Cloud Storage[/bold #cba6f7]", box=box.ROUNDED, border_style="#cba6f7")
        )
    else:
        # Compact 2-column layout for standard terminals (< 115 cols)
        layout["summary"].split_row(
            Layout(name="col_left", ratio=1),
            Layout(name="col_right", ratio=1),
        )
        # Left: Throughput & Remote Quota
        left_table = Table.grid(padding=(0, 1), expand=True)
        left_table.add_column(style="dim", width=13, no_wrap=True)
        left_table.add_column(style="bold", no_wrap=True)
        perf_speed_str = (
            f"[bold #a6e3a1]{format_bytes(speed)}/s[/bold #a6e3a1]"
            if speed > 0
            else "[dim]0 B/s (Idle)[/dim]"
        )
        left_table.add_row("Speed:", perf_speed_str)
        left_table.add_row("Transferred:", f"{format_bytes(total_bytes)} ({transfers_done} files)")
        left_table.add_row("Session:", f"Uptime {uptime} │ {checks} checks")
        if mount_usage:
            gdrive_pct = (mount_usage.used / mount_usage.total * 100) if mount_usage.total > 0 else 0
            left_table.add_row("GDrive Quota:", f"{format_bytes(mount_usage.used)} / {format_bytes(mount_usage.total)} ({gdrive_pct:.1f}%)")
            pbar_len = max(10, width // 6)
            quota_pbar = ProgressBar(total=100, completed=gdrive_pct, width=pbar_len, style="dim", complete_style="#cba6f7")
            left_table.add_row("Quota Free:", f"{format_bytes(mount_usage.free)} free")
        else:
            left_table.add_row("GDrive Quota:", "[yellow]Mount offline[/yellow]")
            left_table.add_row("Quota Free:", "[dim]---[/dim]")
        layout["col_left"].update(
            Panel(left_table, title="[bold #a6e3a1]⚡ Throughput & Storage[/bold #a6e3a1]", box=box.ROUNDED, border_style="#a6e3a1")
        )

        # Right: VFS Cache & Local sync
        right_table = Table.grid(padding=(0, 1), expand=True)
        right_table.add_column(style="dim", width=13, no_wrap=True)
        right_table.add_column(no_wrap=True)
        right_table.add_row("Cache Usage:", f"{format_bytes(cache_used)} / {format_bytes(cache_max)} ({cache_pct:.1f}%)")
        pbar_len = max(10, width // 6)
        cache_pbar = ProgressBar(total=100, completed=cache_pct, width=pbar_len, style="dim", complete_style="#fab387")
        right_table.add_row("Cache Bar:", cache_pbar)
        right_table.add_row("Local Files:", f"{cache_files} cached ({writeback:.0f}s writeback)")
        q_str = f"[bold yellow]{queued} queued[/bold yellow]" if queued > 0 else "[dim]0 queued[/dim]"
        p_str = f"[bold cyan]{in_prog} active[/bold cyan]" if in_prog > 0 else "[dim]0 active[/dim]"
        right_table.add_row("Pending Sync:", f"{q_str}, {p_str}")
        right_table.add_row("Dir Cache:", f"{meta_cache.get('dirs', 0)} dirs, {meta_cache.get('files', 0)} files")
        layout["col_right"].update(
            Panel(right_table, title="[bold #fab387]💾 Local VFS Disk Cache[/bold #fab387]", box=box.ROUNDED, border_style="#fab387")
        )

    # 3. Active Transfers Table
    transferring = stats.get("transferring", []) if stats else []
    if transferring:
        t_table = Table(box=box.SIMPLE, expand=True, padding=(0, 1), show_edge=False)
        t_table.add_column("File Name", style="bold cyan", ratio=3, overflow="ellipsis")
        t_table.add_column("Size", justify="right", style="dim", width=10, no_wrap=True)
        t_table.add_column("Transferred", justify="right", style="dim", width=12, no_wrap=True)
        t_table.add_column("Progress", ratio=2)
        t_table.add_column("Speed", justify="right", style="bold green", width=12, no_wrap=True)
        t_table.add_column("ETA", justify="right", style="#f9e2af", width=8, no_wrap=True)

        for item in transferring[:6]:
            name = item.get("name", "unknown")
            size = item.get("size", 0)
            bytes_done = item.get("bytes", 0)
            pct = item.get("percentage", 0)
            sp = item.get("speed", 0)
            eta = item.get("eta")
            eta_str = f"{eta}s" if eta is not None else "--"
            pbar = ProgressBar(total=100, completed=pct, width=max(10, width // 7), complete_style="#a6e3a1")
            t_table.add_row(
                name,
                format_bytes(size),
                format_bytes(bytes_done),
                pbar,
                f"{format_bytes(sp)}/s",
                eta_str,
            )
        layout["transfers"].update(
            Panel(t_table, title="[bold #89dceb]↑ Active File Transfers[/bold #89dceb]", box=box.ROUNDED, border_style="#89dceb")
        )
    else:
        idle_msg = Text.from_markup("[dim]● No file transfers currently in progress. Remote filesystem is idle.[/dim]")
        layout["transfers"].update(
            Panel(Align.center(idle_msg, vertical="middle"), title="[bold #89dceb]↑ Active File Transfers[/bold #89dceb]", box=box.ROUNDED, border_style="#89dceb")
        )

    # 4. Bottom Section: Recent Transfers (Left) and Diagnostics (Right)
    layout["bottom"].split_row(
        Layout(name="recent", ratio=3),
        Layout(name="diagnostics", ratio=2),
    )

    # Recent Transfers
    recent_list = transferred.get("transferred", []) if transferred else []
    if recent_list:
        r_table = Table(box=box.SIMPLE, expand=True, padding=(0, 1), show_edge=False)
        r_table.add_column("Status", width=9, no_wrap=True)
        r_table.add_column("File Name", ratio=2, overflow="ellipsis")
        r_table.add_column("Size", justify="right", width=10, no_wrap=True)
        r_table.add_column("Completed", justify="right", width=10, no_wrap=True)

        for t in reversed(recent_list[-5:]):
            err = t.get("error")
            status_icon = "[bold red]✖ Error[/bold red]" if err else "[bold green]✔ Done[/bold green]"
            name = t.get("name", "unknown")
            size = t.get("size", 0)
            comp_at = t.get("completed_at", "")
            time_part = comp_at.split("T")[1][:8] if "T" in comp_at else "--:--:--"
            r_table.add_row(status_icon, name, format_bytes(size), time_part)
        layout["recent"].update(
            Panel(r_table, title="[bold #94e2d5]◷ Recent Transfer Activity[/bold #94e2d5]", box=box.ROUNDED, border_style="#94e2d5")
        )
    else:
        empty_msg = Text.from_markup("[dim]No transfers recorded in current daemon session.[/dim]")
        layout["recent"].update(
            Panel(Align.center(empty_msg, vertical="middle"), title="[bold #94e2d5]◷ Recent Transfer Activity[/bold #94e2d5]", box=box.ROUNDED, border_style="#94e2d5")
        )

    # Diagnostics
    diag_table = Table.grid(padding=(0, 1), expand=True)
    diag_table.add_column(style="dim", width=11, no_wrap=True)
    diag_table.add_column(no_wrap=True)
    diag_table.add_row("Rclone Ver:", version.get("version", "unknown") if version else "unknown")
    if memstats:
        alloc = format_bytes(memstats.get("HeapAlloc", 0))
        sys_mem = format_bytes(memstats.get("Sys", 0))
        diag_table.add_row("Daemon Mem:", f"{alloc} (Sys {sys_mem})")
    else:
        diag_table.add_row("Daemon Mem:", "unknown")

    err_count = stats.get("errors", 0) if stats else 0
    if is_rate_limited:
        diag_table.add_row("Health:", "[bold red]⚠ 403 Rate Limited[/bold red]")
        diag_table.add_row("Quota State:", "[red]Google Quota Throttled[/red]")
    elif err_count > 0:
        diag_table.add_row("Health:", f"[bold red]{err_count} errors[/bold red]")
        last_err = stats.get("lastError", "")
        if last_err:
            short_err = (last_err[:25] + "...") if len(last_err) > 25 else last_err
            diag_table.add_row("Last Err:", f"[red]{short_err}[/red]")
    else:
        diag_table.add_row("Health:", "[bold green]✔ Healthy (0 err)[/bold green]")

    tps_val = options.get("main", {}).get("TPSLimit", 0) if options else 0
    tps_str = f"{tps_val}/s" if tps_val > 0 else "Unlimited"
    diag_table.add_row("TPS Limit:", tps_str)

    bw_rate = bwlimit.get("rate", "off") if bwlimit else "off"
    diag_table.add_row("Bandwidth:", f"{bw_rate.capitalize()} (Unlimited)" if bw_rate == "off" else bw_rate)
    layout["diagnostics"].update(
        Panel(diag_table, title="[bold #f9e2af]⚙ Diagnostics[/bold #f9e2af]", box=box.ROUNDED, border_style="#f9e2af")
    )

    # 5. Footer
    footer_table = Table.grid(expand=True)
    footer_table.add_column(justify="left", ratio=2)
    footer_table.add_column(justify="right", ratio=1)

    keybinds = Text.from_markup(
        "[bold cyan][q][/bold cyan] Quit  "
        "[bold cyan][r][/bold cyan] Refresh  "
        "[bold cyan][f][/bold cyan] Forget Cache  "
        "[bold cyan][c][/bold cyan] Reset Counters  "
        "[bold cyan][?][/bold cyan] Help"
    )
    notify_text = Text.from_markup(notification if notification else "[dim]1s interval[/dim]")
    footer_table.add_row(keybinds, notify_text)
    layout["footer"].update(footer_table)

    return layout


def run_dashboard(rc_url: str, interval: float, once: bool = False) -> int:
    console = Console()
    show_help = False
    notification_msg: Optional[str] = None
    notification_expire: float = 0.0

    def sig_exit(signum: Any, frame: Any) -> None:
        restore_terminal()
        console.show_cursor(True)
        sys.exit(0)

    signal.signal(signal.SIGINT, sig_exit)
    signal.signal(signal.SIGTERM, sig_exit)

    # If running once or non-interactive
    if once or not sys.stdout.isatty():
        stats = fetch_rc("core/stats", rc_url)
        if stats is None:
            service_status = get_systemd_status()
            console.print(build_offline_panel(rc_url, service_status, console.width))
            return 1

        vfs = fetch_rc("vfs/stats", rc_url)
        transferred = fetch_rc("core/transferred", rc_url)
        memstats = fetch_rc("core/memstats", rc_url)
        version = fetch_rc("core/version", rc_url)
        bwlimit = fetch_rc("core/bwlimit", rc_url)
        options = fetch_rc("options/get", rc_url)

        layout = build_dashboard(
            console, stats, vfs, transferred, memstats, version, bwlimit, options=options
        )
        console.print(layout)
        return 0

    # Interactive live dashboard
    setup_terminal()
    try:
        console.show_cursor(False)
        with Live(console=console, screen=True, auto_refresh=False) as live:
            last_fetch_time = 0.0
            stats = None
            vfs = None
            transferred = None
            memstats = None
            version = None
            bwlimit = None
            options = None

            while True:
                current_time = time.time()

                # Clear expired notification
                if notification_msg and current_time > notification_expire:
                    notification_msg = None

                # Poll RC server if interval has elapsed
                if current_time - last_fetch_time >= interval or stats is None:
                    stats = fetch_rc("core/stats", rc_url)
                    if stats is not None:
                        vfs = fetch_rc("vfs/stats", rc_url)
                        transferred = fetch_rc("core/transferred", rc_url)
                        memstats = fetch_rc("core/memstats", rc_url)
                        version = fetch_rc("core/version", rc_url)
                        bwlimit = fetch_rc("core/bwlimit", rc_url)
                        options = fetch_rc("options/get", rc_url)
                    last_fetch_time = current_time

                # Render dashboard or offline screen
                if stats is not None:
                    layout = build_dashboard(
                        console,
                        stats,
                        vfs,
                        transferred,
                        memstats,
                        version,
                        bwlimit,
                        options=options,
                        notification=notification_msg,
                        show_help=show_help,
                    )
                    live.update(layout, refresh=True)
                else:
                    service_status = get_systemd_status()
                    offline_panel = build_offline_panel(rc_url, service_status, console.width)
                    live.update(offline_panel, refresh=True)

                # Check for keyboard input
                key = get_key_non_blocking()
                if key:
                    if key in ("q", "Q", "\x1b"):
                        if show_help:
                            show_help = False
                        else:
                            break
                    elif key in ("?", "h", "H"):
                        show_help = not show_help
                    elif key in ("r", "R"):
                        # Force refresh
                        last_fetch_time = 0.0
                        notification_msg = "[bold green]✔ Refreshed[/bold green]"
                        notification_expire = time.time() + 2.0
                    elif key in ("f", "F"):
                        # Forget VFS directory cache
                        success = post_rc("vfs/forget", rc_url)
                        if success:
                            notification_msg = "[bold green]✔ VFS Directory Cache Dropped[/bold green]"
                        else:
                            notification_msg = "[bold red]✖ Failed to drop VFS cache[/bold red]"
                        notification_expire = time.time() + 3.0
                        last_fetch_time = 0.0
                    elif key in ("c", "C"):
                        # Reset stats counters
                        success = post_rc("core/stats-reset", rc_url)
                        if success:
                            notification_msg = "[bold green]✔ Counters Reset[/bold green]"
                        else:
                            notification_msg = "[bold red]✖ Failed to reset counters[/bold red]"
                        notification_expire = time.time() + 3.0
                        last_fetch_time = 0.0
                    elif key in ("s", "S"):
                        # Attempt to start service
                        notification_msg = "[bold yellow]⟳ Starting rclone-gdrive.service...[/bold yellow]"
                        live.update(
                            build_offline_panel(rc_url, "starting", console.width),
                            refresh=True,
                        )
                        subprocess.run(
                            ["systemctl", "--user", "start", SERVICE_NAME],
                            capture_output=True,
                        )
                        time.sleep(1.0)
                        last_fetch_time = 0.0

                time.sleep(0.1)
    finally:
        restore_terminal()
        console.show_cursor(True)

    return 0


def dump_json(rc_url: str) -> int:
    payload = {
        "timestamp": datetime.now().isoformat(),
        "systemd_service": get_systemd_status(),
        "stats": fetch_rc("core/stats", rc_url),
        "vfs": fetch_rc("vfs/stats", rc_url),
        "transferred": fetch_rc("core/transferred", rc_url),
        "memstats": fetch_rc("core/memstats", rc_url),
        "version": fetch_rc("core/version", rc_url),
        "bwlimit": fetch_rc("core/bwlimit", rc_url),
        "mount_usage": None,
    }
    mount = get_mount_stats(MOUNT_PATH)
    if mount:
        payload["mount_usage"] = {
            "total": mount.total,
            "used": mount.used,
            "free": mount.free,
            "percent_used": (mount.used / mount.total * 100) if mount.total > 0 else 0,
        }
    print(json.dumps(payload, indent=2))
    return 0 if payload["stats"] is not None else 1


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="gdrive-stats",
        description="Visual TUI Dashboard for Rclone Google Drive Mount Telemetry",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Keybindings (Interactive Mode):
  q, Esc, Ctrl+C   Exit dashboard
  r                Force immediate telemetry refresh
  f                Drop and refresh VFS directory cache (rclone rc vfs/forget)
  c                Reset session transfer counters (rclone rc core/stats-reset)
  s                Attempt to start/restart systemd rclone service
  ?, h             Toggle help overlay

Examples:
  gdrive-stats             # Launch live interactive TUI
  gdrive-stats --once      # Print single snapshot dashboard and exit
  gdrive-stats --json      # Output raw telemetry JSON
  gdrive-stats --forget    # Drop VFS directory cache immediately
""",
    )
    parser.add_argument(
        "-1",
        "--once",
        action="store_true",
        help="Render single snapshot dashboard and exit immediately",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output raw telemetry data as JSON and exit",
    )
    parser.add_argument(
        "-i",
        "--interval",
        type=float,
        default=DEFAULT_INTERVAL,
        help=f"Poll interval in seconds (default: {DEFAULT_INTERVAL})",
    )
    parser.add_argument(
        "--url",
        type=str,
        default=DEFAULT_RC_URL,
        help=f"Rclone Remote Control API URL (default: {DEFAULT_RC_URL})",
    )
    parser.add_argument(
        "--forget",
        action="store_true",
        help="Drop and forget VFS directory cache via RC and exit",
    )
    parser.add_argument(
        "--reset",
        action="store_true",
        help="Reset transfer counters via RC and exit",
    )

    args = parser.parse_args()

    if args.json:
        sys.exit(dump_json(args.url))

    if args.forget:
        if post_rc("vfs/forget", args.url):
            print("Successfully dropped VFS directory cache.")
            sys.exit(0)
        else:
            print("Error: Failed to reach rclone RC to drop cache.", file=sys.stderr)
            sys.exit(1)

    if args.reset:
        if post_rc("core/stats-reset", args.url):
            print("Successfully reset transfer counters.")
            sys.exit(0)
        else:
            print("Error: Failed to reach rclone RC to reset counters.", file=sys.stderr)
            sys.exit(1)

    sys.exit(run_dashboard(args.url, args.interval, once=args.once))


if __name__ == "__main__":
    main()
