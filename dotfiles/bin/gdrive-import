#!/usr/bin/env python3
"""
gdrive-import - High-throughput Camera SD Card & Media Offload Tool for Google Drive.
Part of RKO (Riced Kubuntu OS).
"""

import argparse
import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime
from typing import List, Optional, Tuple

try:
    from rich import box
    from rich.align import Align
    from rich.console import Console
    from rich.layout import Layout
    from rich.live import Live
    from rich.panel import Panel
    from rich.progress import (
        BarColumn,
        DownloadColumn,
        Progress,
        SpinnerColumn,
        TaskProgressColumn,
        TextColumn,
        TimeRemainingColumn,
        TransferSpeedColumn,
    )
    from rich.prompt import Confirm, Prompt
    from rich.table import Table
    from rich.text import Text
except ImportError:
    print(
        "Error: 'rich' Python package is required. Install via: sudo apt install python3-rich",
        file=sys.stderr,
    )
    sys.exit(1)

console = Console()

DEFAULT_REMOTE = "gdrive"
DEFAULT_BASE_DEST = "Media/Camera Uploads"
DEFAULT_CHUNK_SIZE = "128M"
DEFAULT_TRANSFERS = 4
DEFAULT_CHECKERS = 8
DEFAULT_TPS_LIMIT = 10


def format_bytes(n: Optional[float]) -> str:
    if n is None or n < 0:
        return "0 B"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if abs(n) < 1024.0:
            return f"{n:3.1f} {unit}"
        n /= 1024.0
    return f"{n:.1f} PB"


def format_duration(seconds: Optional[float]) -> str:
    if seconds is None or seconds < 0:
        return "00:00:00"
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


def detect_sd_cards() -> List[str]:
    """Scan /media/$USER and /run/media/$USER for mounted camera cards or DCIM directories."""
    candidates = []
    user = os.environ.get("USER", "")
    search_roots = [
        f"/media/{user}",
        f"/run/media/{user}",
        os.path.expanduser("~/Downloads"),
        os.path.expanduser("~/Pictures"),
    ]

    for root in search_roots:
        if not os.path.exists(root):
            continue
        try:
            for entry in os.listdir(root):
                full_path = os.path.join(root, entry)
                if not os.path.isdir(full_path):
                    continue
                # Check for standard camera DCIM structure
                dcim = os.path.join(full_path, "DCIM")
                if os.path.exists(dcim) and os.path.isdir(dcim):
                    candidates.append(dcim)
                else:
                    # Check if directory contains common camera extensions
                    sample_files = glob.glob(f"{full_path}/*.[jJ][pP][gG]") + \
                                   glob.glob(f"{full_path}/*.[rR][aA][wW]") + \
                                   glob.glob(f"{full_path}/*.[aA][rR][wW]") + \
                                   glob.glob(f"{full_path}/*.[cC][rR]2") + \
                                   glob.glob(f"{full_path}/*.[nN][eE][fF]") + \
                                   glob.glob(f"{full_path}/*.[mM][pP]4")
                    if sample_files:
                        candidates.append(full_path)
        except Exception:
            continue

    return list(dict.fromkeys(candidates))


def scan_source(source_path: str) -> Tuple[int, int, List[str]]:
    """Count files, compute total bytes, and gather media extensions."""
    total_files = 0
    total_bytes = 0
    extensions = set()

    for root, _, files in os.walk(source_path):
        for f in files:
            p = os.path.join(root, f)
            try:
                st = os.stat(p)
                total_files += 1
                total_bytes += st.st_size
                _, ext = os.path.splitext(f)
                if ext:
                    extensions.add(ext.lower())
            except Exception:
                continue

    return total_files, total_bytes, sorted(list(extensions))


def run_import(
    source_path: str,
    dest_path: str,
    chunk_size: str = DEFAULT_CHUNK_SIZE,
    transfers: int = DEFAULT_TRANSFERS,
    delete_source: bool = False,
    dry_run: bool = False,
    verify: bool = False,
) -> int:
    source_path = os.path.abspath(os.path.expanduser(source_path))

    if not os.path.exists(source_path):
        console.print(f"[bold red]Error:[/bold red] Source directory does not exist: [cyan]{source_path}[/cyan]")
        return 1

    file_count, total_bytes, extensions = scan_source(source_path)
    if file_count == 0:
        console.print(f"[bold yellow]Warning:[/bold yellow] No files found in: [cyan]{source_path}[/cyan]")
        return 0

    # Clean target remote spec
    if not dest_path.startswith(f"{DEFAULT_REMOTE}:"):
        if ":" not in dest_path:
            dest_remote = f"{DEFAULT_REMOTE}:{dest_path.lstrip('/')}"
        else:
            dest_remote = dest_path
    else:
        dest_remote = dest_path

    # Display pre-flight summary card
    mode_str = "[bold red]MOVE (Delete from SD card upon verified transfer)[/bold red]" if delete_source else "[bold green]COPY (Preserve on SD card)[/bold green]"
    if dry_run:
        mode_str += " [bold yellow][DRY-RUN][/bold yellow]"

    summary_table = Table(box=box.ROUNDED, expand=True, border_style="#89b4fa")
    summary_table.add_column("Parameter", style="dim", width=22)
    summary_table.add_column("Configuration", style="bold")

    summary_table.add_row("Source Directory:", source_path)
    summary_table.add_row("Cloud Destination:", dest_remote)
    summary_table.add_row("Operation Mode:", mode_str)
    summary_table.add_row("Files to Transfer:", f"{file_count} files ({format_bytes(total_bytes)})")
    summary_table.add_row("File Types Detected:", ", ".join(extensions[:8]) if extensions else "various")
    summary_table.add_row("Upload Chunk Size:", f"{chunk_size} (Optimized for Camera Media)")
    summary_table.add_row("Parallel Streams:", f"{transfers} concurrent streams (--tpslimit {DEFAULT_TPS_LIMIT})")

    console.print(Panel(summary_table, title="[bold #89b4fa]📷 Google Drive Camera Offload Setup[/bold #89b4fa]", box=box.ROUNDED))

    # Base rclone command
    action = "move" if delete_source else "copy"
    cmd = [
        "rclone",
        action,
        source_path,
        dest_remote,
        f"--drive-chunk-size={chunk_size}",
        f"--drive-upload-cutoff={chunk_size}",
        f"--transfers={transfers}",
        f"--checkers={DEFAULT_CHECKERS}",
        f"--tpslimit={DEFAULT_TPS_LIMIT}",
        "--tpslimit-burst=2",
        "--drive-pacer-min-sleep=10ms",
        "--drive-pacer-burst=100",
        "--fast-list",
        "--use-json-log",
        "--stats=1s",
        "--stats-log-level=INFO",
    ]

    if dry_run:
        cmd.append("--dry-run")

    start_time = time.time()
    console.print(f"\n[bold green]🚀 Initiating direct streaming transfer to Google Drive...[/bold green]\n")

    overall_progress = Progress(
        SpinnerColumn(),
        TextColumn("[bold #cba6f7]{task.description}[/bold #cba6f7]"),
        BarColumn(complete_style="#a6e3a1", finished_style="#a6e3a1"),
        TaskProgressColumn(),
        DownloadColumn(),
        TransferSpeedColumn(),
        TimeRemainingColumn(),
        console=console,
        expand=True,
    )

    main_task = overall_progress.add_task(
        f"Offloading {file_count} media files",
        total=total_bytes if total_bytes > 0 else 100,
    )

    active_transfers_table = Table(box=box.SIMPLE, show_header=True, expand=True, padding=(0, 1))
    active_transfers_table.add_column("Transferring File", style="bold cyan", ratio=3, overflow="ellipsis")
    active_transfers_table.add_column("Size", justify="right", style="dim", width=12)
    active_transfers_table.add_column("Progress", justify="right", width=12)
    active_transfers_table.add_column("Speed", justify="right", style="bold green", width=12)

    process = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )

    def sig_int(signum, frame):
        console.print("\n[bold yellow]Aborting import process...[/bold yellow]")
        process.terminate()
        try:
            process.wait(timeout=3)
        except Exception:
            process.kill()
        sys.exit(130)

    signal.signal(signal.SIGINT, sig_int)
    signal.signal(signal.SIGTERM, sig_int)

    # Monitor rclone JSON stderr stats
    transferred_bytes_last = 0
    errors_encountered = []
    completed_files = []

    with Live(overall_progress, console=console, refresh_per_second=4):
        while True:
            line = process.stderr.readline()
            if not line and process.poll() is not None:
                break
            if not line:
                continue

            try:
                data = json.loads(line)
                msg = data.get("msg", "")
                stats = data.get("stats")

                if stats:
                    bytes_done = stats.get("bytes", 0)
                    overall_progress.update(main_task, completed=bytes_done)
                    transferred_bytes_last = bytes_done

                # Track individual file completion
                if "Copied (new)" in msg or "Moved (new)" in msg:
                    fname = data.get("object", "")
                    if fname:
                        completed_files.append(fname)

                if data.get("level") == "error":
                    errors_encountered.append(data.get("msg", "Unknown error"))
            except Exception:
                continue

    ret_code = process.wait()
    elapsed = time.time() - start_time

    console.print("\n" + "─" * console.width)
    if ret_code == 0 and not errors_encountered:
        avg_speed = transferred_bytes_last / elapsed if elapsed > 0 else 0
        success_panel = Table.grid(padding=(0, 2))
        success_panel.add_column(style="dim", width=22)
        success_panel.add_column(style="bold")
        success_panel.add_row("Status:", "[bold green]✔ Transfer Completed Successfully[/bold green]")
        success_panel.add_row("Total Files:", f"{file_count} files ({len(completed_files)} uploaded)")
        success_panel.add_row("Total Transferred:", format_bytes(transferred_bytes_last))
        success_panel.add_row("Elapsed Time:", format_duration(elapsed))
        success_panel.add_row("Average Speed:", f"[bold green]{format_bytes(avg_speed)}/s[/bold green]")
        if delete_source and not dry_run:
            success_panel.add_row("SD Card Space:", "[bold green]✔ Freed up source card storage safely[/bold green]")
        console.print(Panel(success_panel, title="[bold #a6e3a1]🎉 Camera Offload Finished[/bold #a6e3a1]", box=box.ROUNDED))
    else:
        console.print(f"[bold red]✖ Import finished with warnings or errors (exit code {ret_code})[/bold red]")
        if errors_encountered:
            for err in errors_encountered[:5]:
                console.print(f"  [red]• {err}[/red]")
        return ret_code

    # Optional post-import hash verification
    if verify and not dry_run and ret_code == 0:
        console.print(f"\n[bold cyan]🔍 Running integrity check against Google Drive MD5 hashes...[/bold cyan]")
        chk_cmd = ["rclone", "check", source_path, dest_remote, "--one-way", "--fast-list"]
        chk_res = subprocess.run(chk_cmd, capture_output=True, text=True)
        if chk_res.returncode == 0:
            console.print("[bold green]✔ All files verified bit-for-bit identical with remote![/bold green]")
        else:
            console.print(f"[bold yellow]Verification notice:[/bold yellow] {chk_res.stderr.strip()}")

    return 0


def main():
    parser = argparse.ArgumentParser(
        prog="gdrive-import",
        description="High-throughput Camera SD Card & Media Offload Tool for Google Drive",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Auto-detect camera card and import into default cloud folder:
  gdrive-import

  # Import from specific DCIM folder:
  gdrive-import /media/$USER/CAMERA_CARD/DCIM

  # Offload and safely free SD card storage after verified transfer:
  gdrive-import /media/$USER/CAMERA_CARD/DCIM --delete-source

  # Test run without transferring or deleting:
  gdrive-import /media/$USER/CAMERA_CARD/DCIM --dry-run
""",
    )
    parser.add_argument(
        "source",
        nargs="?",
        default=None,
        help="Source directory or mount point (defaults to auto-detecting camera card / DCIM)",
    )
    parser.add_argument(
        "destination",
        nargs="?",
        default=None,
        help=f"Google Drive target folder (default: {DEFAULT_BASE_DEST}/<YYYY-MM>)",
    )
    parser.add_argument(
        "--delete-source",
        "--move",
        action="store_true",
        help="Safely delete local files from SD card ONLY after verified cloud upload",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Simulate the offload without transferring files or modifying SD card",
    )
    parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Skip interactive confirmation prompt",
    )
    parser.add_argument(
        "--verify",
        action="store_true",
        help="Perform post-upload hash integrity check against Google Drive",
    )
    parser.add_argument(
        "--chunk-size",
        default=DEFAULT_CHUNK_SIZE,
        help=f"Upload chunk size for camera media (default: {DEFAULT_CHUNK_SIZE})",
    )
    parser.add_argument(
        "--transfers",
        type=int,
        default=DEFAULT_TRANSFERS,
        help=f"Number of parallel file uploads (default: {DEFAULT_TRANSFERS})",
    )

    args = parser.parse_args()

    source = args.source
    if not source:
        candidates = detect_sd_cards()
        if not candidates:
            console.print("[bold yellow]No camera card or DCIM directories auto-detected.[/bold yellow]")
            source = Prompt.ask("Enter source folder path to import from")
        elif len(candidates) == 1:
            console.print(f"[bold green]Auto-detected camera media at:[/bold green] [cyan]{candidates[0]}[/cyan]")
            source = candidates[0]
        else:
            console.print("[bold cyan]Found multiple candidate media directories:[/bold cyan]")
            for idx, c in enumerate(candidates, 1):
                console.print(f"  [{idx}] {c}")
            choice = Prompt.ask("Select directory number", choices=[str(i) for i in range(1, len(candidates) + 1)])
            source = candidates[int(choice) - 1]

    # Compute default destination if omitted (e.g. Media/Camera Uploads/2026-09)
    destination = args.destination
    if not destination:
        current_month = datetime.now().strftime("%Y-%m")
        destination = f"{DEFAULT_REMOTE}:{DEFAULT_BASE_DEST}/{current_month}"

    if not args.yes and not args.dry_run:
        prompt_msg = "Proceed with camera offload to Google Drive?"
        if args.delete_source:
            prompt_msg = "[bold red]Proceed and DELETE source files from card after upload?[/bold red]"
        if not Confirm.ask(prompt_msg, default=True):
            console.print("[yellow]Import canceled by user.[/yellow]")
            sys.exit(0)

    code = run_import(
        source_path=source,
        dest_path=destination,
        chunk_size=args.chunk_size,
        transfers=args.transfers,
        delete_source=args.delete_source,
        dry_run=args.dry_run,
        verify=args.verify,
    )
    sys.exit(code)


if __name__ == "__main__":
    main()
