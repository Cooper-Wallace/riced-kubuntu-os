#!/usr/bin/env python3
"""
gdrive-import - High-throughput Camera SD Card & Media Offload Tool for Google Drive.
Two-stage pipeline: Stage 1 (Photos -> YYYY/MM/), Stage 2 (Videos & Sidecars -> YYYY/MM/videos/).
Part of RKO (Riced Kubuntu OS).
"""

import argparse
import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from collections import defaultdict
from dataclasses import dataclass
from datetime import datetime
from typing import Dict, List, Optional, Set, Tuple

try:
    from rich import box
    from rich.align import Align
    from rich.console import Console, Group
    from rich.layout import Layout
    from rich.live import Live
    from rich.panel import Panel
    from rich.progress import (
        BarColumn,
        DownloadColumn,
        MofNCompleteColumn,
        Progress,
        SpinnerColumn,
        TaskProgressColumn,
        TextColumn,
        TimeRemainingColumn,
        TransferSpeedColumn,
    )
    from rich.prompt import Confirm, Prompt
    from rich.table import Table
    from rich.text import Text
except ImportError:
    print(
        "Error: 'rich' Python package is required. Install via: sudo apt install python3-rich",
        file=sys.stderr,
    )
    sys.exit(1)

# Register RAW image extensions with PIL if available
try:
    from PIL import Image, TiffImagePlugin
    from PIL.ExifTags import Base, IFD

    for ext in [".arw", ".cr2", ".cr3", ".nef", ".nrw", ".dng", ".orf", ".rw2", ".pef", ".sr2", ".srf"]:
        try:
            Image.register_extension(TiffImagePlugin.TiffImageFile.format, ext)
        except Exception:
            pass
    PIL_AVAILABLE = True
except ImportError:
    PIL_AVAILABLE = False

console = Console()

DEFAULT_REMOTE = "gdrive"
DEFAULT_BASE_DEST = "Media/Raw Camera Files"
DEFAULT_CHUNK_SIZE = "128M"
DEFAULT_TRANSFERS = 4
DEFAULT_CHECKERS = 8
DEFAULT_TPS_LIMIT = 10

PHOTO_EXTENSIONS: Set[str] = {
    ".jpg", ".jpeg", ".arw", ".cr2", ".cr3", ".nef", ".nrw",
    ".dng", ".raf", ".orf", ".rw2", ".pef", ".sr2", ".srf",
    ".heic", ".heif", ".tif", ".tiff", ".png", ".webp", ".xmp",
}

VIDEO_EXTENSIONS: Set[str] = {
    ".mp4", ".mov", ".m4v", ".avi", ".mkv", ".mts", ".m2ts",
}

# Directories to ignore (internal camera management databases and low-res playback thumbnails)
IGNORED_DIRS: Set[str] = {"AVF_INFO", "BDMV", "THMBNL", "GENERAL", "BACKUP"}


def ensure_sleep_inhibited(who: str = "gdrive-import", why: str = "Keep system awake during camera media offload to Google Drive") -> None:
    """Re-executes current script under systemd-inhibit to prevent idle suspend."""
    if any(arg in sys.argv for arg in ("--no-inhibit", "-h", "--help")):
        return
    if os.environ.get("RKO_SLEEP_INHIBITED"):
        return
    if shutil.which("systemd-inhibit"):
        env = dict(os.environ)
        env["RKO_SLEEP_INHIBITED"] = "1"
        try:
            target_script = os.path.abspath(sys.argv[0])
            os.execvpe(
                "systemd-inhibit",
                [
                    "systemd-inhibit",
                    "--what=idle:sleep",
                    f"--who={who}",
                    f"--why={why}",
                    sys.executable,
                    target_script,
                ] + sys.argv[1:],
                env,
            )
        except Exception:
            pass


def set_terminal_title(title: str) -> None:
    """Set terminal window/tab/browser app title via standard OSC escape sequence."""
    if sys.stdout.isatty():
        sys.stdout.write(f"\033]0;{title}\007")
        sys.stdout.flush()


def restore_terminal_title() -> None:
    """Reset terminal window/tab/browser app title."""
    if sys.stdout.isatty():
        sys.stdout.write("\033]0;\007")
        sys.stdout.flush()


@dataclass
class MediaItem:
    abs_path: str
    filename: str
    dirpath: str
    size: int
    year: str
    month: str
    mtime: float
    asset_type: str  # "photo" or "video"


def format_bytes(n: Optional[float]) -> str:
    if n is None or n < 0:
        return "0 B"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if abs(n) < 1024.0:
            return f"{n:3.1f} {unit}"
        n /= 1024.0
    return f"{n:.1f} PB"


def format_duration(seconds: Optional[float]) -> str:
    if seconds is None or seconds < 0:
        return "00:00:00"
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


def detect_sd_cards() -> List[str]:
    """Scan /run/media/$USER and /media/$USER for mounted camera cards or media volumes."""
    candidates = []
    user = os.environ.get("USER", "")
    search_roots = [
        f"/run/media/{user}",
        f"/media/{user}",
        os.path.expanduser("~/Downloads"),
        os.path.expanduser("~/Pictures"),
    ]

    for root in search_roots:
        if not os.path.exists(root):
            continue
        try:
            for entry in os.listdir(root):
                full_path = os.path.join(root, entry)
                if not os.path.isdir(full_path):
                    continue
                # Check for camera volume structure (DCIM or PRIVATE)
                has_dcim = os.path.exists(os.path.join(full_path, "DCIM"))
                has_private = os.path.exists(os.path.join(full_path, "PRIVATE"))
                if has_dcim or has_private:
                    candidates.append(full_path)
                else:
                    # Check if directory directly contains media files
                    sample_photos = any(
                        f.lower().endswith(tuple(PHOTO_EXTENSIONS | VIDEO_EXTENSIONS))
                        for f in os.listdir(full_path)[:30]
                        if os.path.isfile(os.path.join(full_path, f))
                    )
                    if sample_photos:
                        candidates.append(full_path)
        except Exception:
            continue

    return list(dict.fromkeys(candidates))


def extract_capture_date(filepath: str) -> Tuple[str, str]:
    """
    Determine the capture date (year, month) for a file based on metadata:
    1. EXIF DateTimeOriginal / DateTimeDigitized / DateTime (for JPEG, TIFF, RAW)
    2. Filename date pattern (e.g. IMG_YYYYMMDD_... or YYYY-MM-DD_...)
    3. Video metadata via ffprobe (creation_time)
    4. Filesystem modification time (set at recording time by camera firmware)
    5. Fallback to current year/month.
    """
    # 1. EXIF metadata for images
    if PIL_AVAILABLE:
        try:
            with Image.open(filepath) as img:
                exif = img.getexif()
                if exif:
                    dt_str = None
                    try:
                        ifd = exif.get_ifd(IFD.Exif)
                        dt_str = ifd.get(Base.DateTimeOriginal) or ifd.get(Base.DateTimeDigitized)
                    except Exception:
                        pass
                    if not dt_str:
                        dt_str = exif.get(Base.DateTime)
                    if dt_str and isinstance(dt_str, str):
                        m = re.match(r"^(\d{4})[:\-](\d{2})", dt_str.strip())
                        if m:
                            y, mo = int(m.group(1)), int(m.group(2))
                            if 1970 <= y <= 2100 and 1 <= mo <= 12:
                                return f"{y:04d}", f"{mo:02d}"
        except Exception:
            pass

    # 2. Filename date pattern
    bname = os.path.basename(filepath)
    m = re.search(
        r"(?:IMG_|VID_|PXL_|DJI_|\b)(19\d\d|20\d\d)[-_]?(0[1-9]|1[0-2])[-_]?(0[1-9]|[12]\d|3[01])",
        bname,
    )
    if m:
        y, mo = int(m.group(1)), int(m.group(2))
        if 1970 <= y <= 2100 and 1 <= mo <= 12:
            return f"{y:04d}", f"{mo:02d}"

    # 3. Video metadata via ffprobe (quick check with timeout)
    _, ext = os.path.splitext(filepath)
    if ext.lower() in VIDEO_EXTENSIONS:
        try:
            cmd = [
                "ffprobe",
                "-v",
                "error",
                "-show_entries",
                "format_tags=creation_time:stream_tags=creation_time",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                filepath,
            ]
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=1.5)
            if res.returncode == 0 and res.stdout.strip():
                for line in res.stdout.strip().splitlines():
                    m = re.match(r"^(\d{4})[:\-](\d{2})", line.strip())
                    if m:
                        y, mo = int(m.group(1)), int(m.group(2))
                        if 1970 <= y <= 2100 and 1 <= mo <= 12:
                            return f"{y:04d}", f"{mo:02d}"
        except Exception:
            pass

    # 4. Filesystem mtime (camera firmware writes mtime at capture time on SD card)
    try:
        mtime = os.path.getmtime(filepath)
        if mtime > 0:
            dt = datetime.fromtimestamp(mtime)
            if 1970 <= dt.year <= 2100:
                return f"{dt.year:04d}", f"{dt.month:02d}"
    except Exception:
        pass

    now = datetime.now()
    return f"{now.year:04d}", f"{now.month:02d}"


def scan_photos(source_path: str) -> Dict[Tuple[str, str], List[MediaItem]]:
    """
    Stage 1: Specifically gather photo files from DCIM/ (or source_path if already in DCIM).
    Excludes camera system folders and video assets.
    """
    dcim_dir = os.path.join(source_path, "DCIM")
    search_root = dcim_dir if os.path.isdir(dcim_dir) else source_path

    photos_by_date: Dict[Tuple[str, str], List[MediaItem]] = defaultdict(list)

    for root, dirs, files in os.walk(search_root):
        dirs[:] = [d for d in dirs if d.upper() not in IGNORED_DIRS and not d.startswith(".")]

        # Avoid scanning video directories during photo stage
        if "PRIVATE" in root.split(os.sep):
            continue

        for f in sorted(files):
            if f.startswith("."):
                continue
            _, ext = os.path.splitext(f)
            if ext.lower() in PHOTO_EXTENSIONS:
                abs_p = os.path.join(root, f)
                try:
                    st = os.stat(abs_p)
                    year, month = extract_capture_date(abs_p)
                    item = MediaItem(
                        abs_path=abs_p,
                        filename=f,
                        dirpath=root,
                        size=st.st_size,
                        year=year,
                        month=month,
                        mtime=st.st_mtime,
                        asset_type="photo",
                    )
                    photos_by_date[(year, month)].append(item)
                except Exception:
                    continue

    return photos_by_date


def scan_videos(source_path: str) -> Dict[Tuple[str, str], List[MediaItem]]:
    """
    Stage 2: Specifically gather video files (.mp4, .mov, etc.) and paired sidecars (.xml)
    from video directories (PRIVATE/M4ROOT/CLIP, PRIVATE/AVCHD, or DCIM).
    """
    videos_by_date: Dict[Tuple[str, str], List[MediaItem]] = defaultdict(list)

    search_roots = []
    sony_clip = os.path.join(source_path, "PRIVATE", "M4ROOT", "CLIP")
    sony_private = os.path.join(source_path, "PRIVATE")
    dcim_dir = os.path.join(source_path, "DCIM")

    if os.path.isdir(sony_clip):
        search_roots.append(sony_clip)
    elif os.path.isdir(sony_private):
        search_roots.append(sony_private)

    if os.path.isdir(dcim_dir):
        search_roots.append(dcim_dir)
    elif not search_roots:
        search_roots.append(source_path)

    seen_abs_paths = set()

    for s_root in search_roots:
        for root, dirs, files in os.walk(s_root):
            dirs[:] = [d for d in dirs if d.upper() not in IGNORED_DIRS and not d.startswith(".")]

            video_files = [
                f for f in sorted(files)
                if os.path.splitext(f)[1].lower() in VIDEO_EXTENSIONS and not f.startswith(".")
            ]
            sidecar_files = [
                f for f in sorted(files)
                if os.path.splitext(f)[1].lower() in {".xml", ".xmp"} and not f.startswith(".")
            ]

            for vf in video_files:
                abs_p = os.path.join(root, vf)
                if abs_p in seen_abs_paths:
                    continue
                seen_abs_paths.add(abs_p)
                try:
                    st = os.stat(abs_p)
                    year, month = extract_capture_date(abs_p)
                    v_item = MediaItem(
                        abs_path=abs_p,
                        filename=vf,
                        dirpath=root,
                        size=st.st_size,
                        year=year,
                        month=month,
                        mtime=st.st_mtime,
                        asset_type="video",
                    )
                    videos_by_date[(year, month)].append(v_item)

                    # Look for paired sidecar (e.g. C0001.MP4 -> C0001M01.XML or C0001.XML)
                    stem = os.path.splitext(vf)[0]
                    for sc in sidecar_files:
                        sc_abs = os.path.join(root, sc)
                        if sc_abs in seen_abs_paths:
                            continue
                        if sc.lower().startswith(stem.lower()):
                            seen_abs_paths.add(sc_abs)
                            sc_st = os.stat(sc_abs)
                            sc_item = MediaItem(
                                abs_path=sc_abs,
                                filename=sc,
                                dirpath=root,
                                size=sc_st.st_size,
                                year=year,
                                month=month,
                                mtime=sc_st.st_mtime,
                                asset_type="video",
                            )
                            videos_by_date[(year, month)].append(sc_item)
                except Exception:
                    continue

    return videos_by_date


def make_streams_table(streams: List[Dict[str, Any]]) -> Table:
    table = Table(box=box.SIMPLE_HEAD, expand=True, padding=(0, 1))
    table.add_column("Active Stream", style="bold cyan", ratio=3)
    table.add_column("Size", style="dim", justify="right", ratio=1)
    table.add_column("Progress", style="bold green", justify="center", ratio=2)
    table.add_column("Speed", style="green", justify="right", ratio=2)
    table.add_column("ETA", style="yellow", justify="right", ratio=1)

    if not streams:
        table.add_row("[dim]Awaiting active cloud upload streams...[/dim]", "-", "-", "-", "-")
        return table

    for s in streams[:4]:
        pct = s.get("percentage", 0)
        bar_len = 10
        filled = int(bar_len * (pct / 100))
        bar = f"[#a6e3a1]{'━' * filled}[/#a6e3a1][dim]{'━' * (bar_len - filled)}[/dim]"
        speed = s.get("speed", 0)
        eta = s.get("eta")
        table.add_row(
            s.get("name", ""),
            format_bytes(s.get("size", 0)),
            f"{bar} {pct}%",
            f"{format_bytes(speed)}/s" if speed else "-",
            format_duration(eta) if eta is not None else "-",
        )
    return table


def run_import(
    source_path: str,
    dest_path: Optional[str] = None,
    chunk_size: str = DEFAULT_CHUNK_SIZE,
    transfers: int = DEFAULT_TRANSFERS,
    delete_source: bool = False,
    dry_run: bool = False,
    verify: bool = False,
    ignore_existing: bool = False,
    camera_mode: bool = False,
    sort_by_date: bool = True,
    photos_only: bool = False,
    videos_only: bool = False,
) -> int:
    source_path = os.path.abspath(os.path.expanduser(source_path))

    if not os.path.exists(source_path):
        console.print(f"[bold red]Error:[/bold red] Source path does not exist: [cyan]{source_path}[/cyan]")
        return 1

    # Clean target remote spec
    if not dest_path:
        if camera_mode:
            base_dest = f"{DEFAULT_REMOTE}:{DEFAULT_BASE_DEST}"
        else:
            bname = os.path.basename(source_path.rstrip(os.sep)) or "root"
            base_dest = f"{DEFAULT_REMOTE}:Media/Backups/{bname}"
    elif not dest_path.startswith(f"{DEFAULT_REMOTE}:"):
        if ":" not in dest_path:
            base_dest = f"{DEFAULT_REMOTE}:{dest_path.lstrip('/')}"
        else:
            base_dest = dest_path
    else:
        base_dest = dest_path

    # Gather items based on pipeline mode
    # Entry format: (batch_label, target_remote, by_dir_map, uses_files_from)
    batches_queue: List[Tuple[str, str, Dict[str, List[str]], bool]] = []

    total_photo_count = 0
    total_photo_bytes = 0
    total_video_count = 0
    total_video_bytes = 0

    if camera_mode:
        photos_by_date: Dict[Tuple[str, str], List[MediaItem]] = defaultdict(list)
        videos_by_date: Dict[Tuple[str, str], List[MediaItem]] = defaultdict(list)

        with console.status("[bold cyan]🔍 Scanning camera card (Photos from DCIM/, Videos from PRIVATE/)...[/bold cyan]"):
            if not videos_only:
                photos_by_date = scan_photos(source_path)
            if not photos_only:
                videos_by_date = scan_videos(source_path)

        total_photo_count = sum(len(v) for v in photos_by_date.values())
        total_photo_bytes = sum(it.size for v in photos_by_date.values() for it in v)
        total_video_count = sum(len(v) for v in videos_by_date.values())
        total_video_bytes = sum(it.size for v in videos_by_date.values() for it in v)

        total_files = total_photo_count + total_video_count
        total_bytes = total_photo_bytes + total_video_bytes

        if total_files == 0:
            console.print(f"[bold yellow]Warning:[/bold yellow] No media files found in camera source: [cyan]{source_path}[/cyan]")
            return 0

        # Queue Stage 1: Photos (flattening 100MSDCF)
        if not videos_only:
            for (y, mo) in sorted(photos_by_date.keys()):
                items = photos_by_date[(y, mo)]
                target_remote = f"{base_dest}/{y}/{mo}" if sort_by_date else base_dest
                by_dir = defaultdict(list)
                for it in items:
                    by_dir[it.dirpath].append(it.filename)
                batches_queue.append((f"Photos {y}/{mo}", target_remote, by_dir, True))

        # Queue Stage 2: Videos & Sidecars (flattening CLIP)
        if not photos_only:
            for (y, mo) in sorted(videos_by_date.keys()):
                items = videos_by_date[(y, mo)]
                target_remote = f"{base_dest}/{y}/{mo}/videos" if sort_by_date else f"{base_dest}/videos"
                by_dir = defaultdict(list)
                for it in items:
                    by_dir[it.dirpath].append(it.filename)
                batches_queue.append((f"Videos {y}/{mo}", target_remote, by_dir, True))

    else:
        # Generic backup mode
        if os.path.isfile(source_path):
            st = os.stat(source_path)
            total_files = 1
            total_bytes = st.st_size
            bname = os.path.basename(source_path)
            batches_queue.append((f"File: {bname}", base_dest, {os.path.dirname(source_path): [bname]}, True))
        else:
            with console.status(f"[bold cyan]🔍 Scanning local directory: {source_path}...[/bold cyan]"):
                file_count = 0
                byte_count = 0
                for root, _, files in os.walk(source_path):
                    for f in files:
                        if f in {".DS_Store", "Thumbs.db"}:
                            continue
                        abs_f = os.path.join(root, f)
                        try:
                            byte_count += os.path.getsize(abs_f)
                            file_count += 1
                        except Exception:
                            pass
                total_files = file_count
                total_bytes = byte_count

            if total_files == 0:
                console.print(f"[bold yellow]Warning:[/bold yellow] No files found to backup in: [cyan]{source_path}[/cyan]")
                return 0

            bname = os.path.basename(source_path.rstrip(os.sep))
            batches_queue.append((f"Folder: {bname}", base_dest, {source_path: []}, False))

    mode_str = (
        "[bold red]MOVE (Delete from source upon verified transfer)[/bold red]"
        if delete_source
        else "[bold green]COPY (Preserve on source)[/bold green]"
    )
    if dry_run:
        mode_str += " [bold yellow][DRY-RUN][/bold yellow]"

    dup_policy = (
        "Skip all existing files on destination (--ignore-existing)"
        if ignore_existing
        else "Skip identical files (MD5 Checksum & Size comparison)"
    )

    # Pre-flight setup table
    summary_table = Table(box=box.ROUNDED, expand=True, border_style="#89b4fa")
    summary_table.add_column("Parameter", style="dim", width=22)
    summary_table.add_column("Configuration", style="bold")

    summary_table.add_row("Source Path:", source_path)
    summary_table.add_row("Cloud Destination:", base_dest)
    summary_table.add_row("Operation Mode:", mode_str)
    summary_table.add_row("Deduplication Policy:", f"[bold cyan]{dup_policy}[/bold cyan]")

    if camera_mode:
        pipeline_str = []
        if not videos_only:
            pipeline_str.append(f"Stage 1 (Photos → {base_dest}/YYYY/MM/)")
        if not photos_only:
            pipeline_str.append(f"Stage 2 (Videos & Sidecars → {base_dest}/YYYY/MM/videos/)")
        summary_table.add_row("Active Pipelines:", " + ".join(pipeline_str))

        summary_table.add_row("Total Assets:", f"{total_files} files ({format_bytes(total_bytes)})")

        if not videos_only:
            photo_lines = []
            for (y, mo) in sorted(photos_by_date.keys()):
                items = photos_by_date[(y, mo)]
                m_bytes = sum(it.size for it in items)
                photo_lines.append(f"• {y}/{mo}: {len(items)} photos ({format_bytes(m_bytes)}) → {base_dest}/{y}/{mo}/")
            summary_table.add_row(f"Photos ({total_photo_count} files):", "\n".join(photo_lines) if photo_lines else "None")

        if not photos_only:
            video_lines = []
            for (y, mo) in sorted(videos_by_date.keys()):
                items = videos_by_date[(y, mo)]
                m_bytes = sum(it.size for it in items)
                video_lines.append(f"• {y}/{mo}: {len(items)} assets ({format_bytes(m_bytes)}) → {base_dest}/{y}/{mo}/videos/")
            summary_table.add_row(f"Videos ({total_video_count} files):", "\n".join(video_lines) if video_lines else "None")
    else:
        summary_table.add_row("Total Assets:", f"{total_files} files ({format_bytes(total_bytes)})")

    summary_table.add_row("Upload Chunk Size:", f"{chunk_size} (Optimized for Media)")
    summary_table.add_row("Parallel Streams:", f"{transfers} concurrent streams (--tpslimit {DEFAULT_TPS_LIMIT})")

    panel_title = "[bold #89b4fa]📷 Google Drive Camera Offload Setup[/bold #89b4fa]" if camera_mode else "[bold #89b4fa]☁️ Google Drive Backup Setup[/bold #89b4fa]"
    console.print(Panel(summary_table, title=panel_title, box=box.ROUNDED))

    # Signal handling for safe child termination and temp file cleanup
    current_process = None
    temp_files_to_clean = []

    def sig_int(signum, frame):
        restore_terminal_title()
        console.print("\n[bold yellow]Aborting import process...[/bold yellow]")
        if current_process:
            current_process.terminate()
            try:
                current_process.wait(timeout=3)
            except Exception:
                current_process.kill()
        for tf in temp_files_to_clean:
            if os.path.exists(tf):
                try:
                    os.unlink(tf)
                except Exception:
                    pass
        sys.exit(130)

    signal.signal(signal.SIGINT, sig_int)
    signal.signal(signal.SIGTERM, sig_int)

    start_time = time.time()
    console.print(f"\n[bold green]🚀 Initiating direct streaming transfer to Google Drive...[/bold green]\n")

    overall_progress = Progress(
        SpinnerColumn(),
        TextColumn("[bold #cba6f7]{task.description}[/bold #cba6f7]"),
        BarColumn(complete_style="#cba6f7", finished_style="#a6e3a1"),
        TaskProgressColumn(),
        DownloadColumn(),
        TimeRemainingColumn(),
        console=console,
    )

    offload_progress = Progress(
        SpinnerColumn(),
        TextColumn("[bold #89dceb]{task.description}[/bold #89dceb]"),
        BarColumn(complete_style="#89dceb", finished_style="#a6e3a1"),
        TaskProgressColumn(),
        MofNCompleteColumn(),
        TextColumn("[dim italic]{task.fields[current_file]}[/dim italic]"),
        console=console,
    )

    upload_progress = Progress(
        SpinnerColumn(),
        TextColumn("[bold #a6e3a1]{task.description}[/bold #a6e3a1]"),
        BarColumn(complete_style="#a6e3a1", finished_style="#a6e3a1"),
        TaskProgressColumn(),
        DownloadColumn(),
        TransferSpeedColumn(),
        TimeRemainingColumn(),
        console=console,
    )

    overall_task = overall_progress.add_task(
        f"Total Offload: {total_files} files ({format_bytes(total_bytes)})",
        total=total_bytes if total_bytes > 0 else 100,
    )
    offload_task = offload_progress.add_task(
        "Stage A (Offload & Verification)",
        total=100,
        current_file="Starting...",
    )
    upload_task = upload_progress.add_task(
        "Stage B (Google Drive Upload)",
        total=100,
    )

    current_streams: List[Dict[str, Any]] = []

    def generate_layout(batch_header: str) -> Group:
        return Group(
            Panel(overall_progress, title="[bold #cba6f7]📂 Total Progress[/bold #cba6f7]", box=box.ROUNDED),
            Panel(
                Group(
                    offload_progress,
                    upload_progress,
                    Table.grid(padding=(0, 0)),
                    Panel(make_streams_table(current_streams), title="[bold #89b4fa]⚡ Concurrent Cloud Upload Streams[/bold #89b4fa]", box=box.ROUNDED),
                ),
                title=f"[bold #89b4fa]{batch_header}[/bold #89b4fa]",
                box=box.ROUNDED,
            ),
        )

    accumulated_bytes = 0
    total_transferred_bytes = 0
    total_skipped_checks = 0
    completed_files = []
    errors_encountered = []
    overall_ret_code = 0
    total_batch_count = len(batches_queue)

    with Live(generate_layout("Preparing transfer..."), console=console, refresh_per_second=4) as live:
        for b_idx, (stage_name, target_remote, by_dir, uses_files_from) in enumerate(batches_queue, 1):
            if uses_files_from:
                batch_item_count = sum(len(flist) for flist in by_dir.values())
            else:
                batch_item_count = total_files

            offload_progress.reset(
                offload_task,
                total=batch_item_count if batch_item_count > 0 else 1,
                description="Stage A (Offload & Verification)",
                current_file="Inspecting files...",
            )
            upload_progress.reset(
                upload_task,
                total=100,
                description="Stage B (Google Drive Upload)",
            )
            current_streams.clear()

            batch_header = f"[{b_idx}/{total_batch_count}] {stage_name} ({batch_item_count} files)"
            live.update(generate_layout(batch_header))

            for d_src, fnames in by_dir.items():
                if uses_files_from and not fnames:
                    continue

                action = "move" if delete_source else "copy"
                cmd = [
                    "rclone",
                    action,
                    d_src,
                    target_remote,
                    "--checksum",
                    f"--drive-chunk-size={chunk_size}",
                    f"--drive-upload-cutoff={chunk_size}",
                    f"--transfers={transfers}",
                    f"--checkers={DEFAULT_CHECKERS}",
                    f"--tpslimit={DEFAULT_TPS_LIMIT}",
                    "--tpslimit-burst=2",
                    "--drive-pacer-min-sleep=10ms",
                    "--drive-pacer-burst=100",
                    "--use-json-log",
                    "--stats=1s",
                    "--stats-log-level=NOTICE",
                ]

                tf_path = None
                if uses_files_from:
                    with tempfile.NamedTemporaryFile("w+", delete=False) as tf:
                        tf.write("\n".join(fnames) + "\n")
                        tf_path = tf.name
                    temp_files_to_clean.append(tf_path)
                    cmd.extend(["--files-from-raw", tf_path])

                if ignore_existing:
                    cmd.append("--ignore-existing")
                if dry_run:
                    cmd.append("--dry-run")

                process = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1,
                )
                current_process = process

                batch_bytes_done = 0
                while True:
                    line = process.stderr.readline()
                    if not line and process.poll() is not None:
                        break
                    if not line:
                        continue

                    try:
                        data = json.loads(line)
                        msg = data.get("msg", "")
                        stats = data.get("stats")

                        if stats:
                            chk_count = stats.get("checks", 0)
                            tot_checks = stats.get("totalChecks", 0) or batch_item_count
                            checking_list = stats.get("checking", [])
                            curr_f = checking_list[0] if checking_list else ""

                            if chk_count >= tot_checks and tot_checks > 0:
                                offload_progress.update(
                                    offload_task,
                                    completed=tot_checks,
                                    total=tot_checks,
                                    description="[bold green]✔ Media Verified & Ready[/bold green]",
                                    current_file="All files checked",
                                )
                            else:
                                offload_progress.update(
                                    offload_task,
                                    completed=chk_count,
                                    total=max(tot_checks, batch_item_count),
                                    current_file=curr_f,
                                )

                            batch_bytes_done = stats.get("bytes", 0)
                            batch_tot_bytes = stats.get("totalBytes", 0)
                            if batch_tot_bytes > 0:
                                upload_progress.update(upload_task, total=batch_tot_bytes)
                            upload_progress.update(upload_task, completed=batch_bytes_done)

                            overall_progress.update(overall_task, completed=accumulated_bytes + batch_bytes_done)
                            total_skipped_checks += stats.get("checks", 0)
                            current_streams = stats.get("transferring", [])

                        if "Copied (new)" in msg or "Moved (new)" in msg or "Skipped copy as --dry-run" in msg:
                            fname = data.get("object", "")
                            if fname and fname not in completed_files:
                                completed_files.append(fname)

                        if data.get("level") == "error":
                            errors_encountered.append(data.get("msg", "Unknown error"))
                    except Exception:
                        continue

                    live.update(generate_layout(batch_header))

                ret = process.wait()
                current_process = None
                if ret != 0:
                    overall_ret_code = ret
                accumulated_bytes += batch_bytes_done
                total_transferred_bytes = accumulated_bytes

                offload_progress.update(
                    offload_task,
                    completed=batch_item_count,
                    total=batch_item_count,
                    description="[bold green]✔ Media Verified & Ready[/bold green]",
                    current_file="",
                )
                if upload_progress.tasks[upload_task].total:
                    upload_progress.update(
                        upload_task,
                        completed=upload_progress.tasks[upload_task].total,
                        description="[bold green]✔ Cloud Upload Complete[/bold green]",
                    )
                current_streams.clear()
                live.update(generate_layout(batch_header))

                if tf_path:
                    try:
                        os.unlink(tf_path)
                        if tf_path in temp_files_to_clean:
                            temp_files_to_clean.remove(tf_path)
                    except Exception:
                        pass

    elapsed = time.time() - start_time

    console.print("\n" + "─" * console.width)
    if overall_ret_code == 0 and not errors_encountered:
        avg_speed = total_transferred_bytes / elapsed if elapsed > 0 else 0
        success_panel = Table.grid(padding=(0, 2))
        success_panel.add_column(style="dim", width=22)
        success_panel.add_column(style="bold")
        success_panel.add_row("Status:", "[bold green]✔ Transfer Completed Successfully[/bold green]")

        file_summary = f"{total_files} files ({len(completed_files)} processed"
        if total_skipped_checks > 0:
            file_summary += f", {total_skipped_checks} checked / identical skipped"
        file_summary += ")"
        success_panel.add_row("Total Files:", file_summary)

        if camera_mode:
            if total_photo_count > 0:
                success_panel.add_row("Photos Processed:", f"{total_photo_count} files ({format_bytes(total_photo_bytes)}) → YYYY/MM/")
            if total_video_count > 0:
                success_panel.add_row("Videos Processed:", f"{total_video_count} files ({format_bytes(total_video_bytes)}) → YYYY/MM/videos/")

        if total_skipped_checks > 0:
            success_panel.add_row("Deduplication:", f"[bold cyan]✔ Verified bit-for-bit with Google Drive[/bold cyan]")

        success_panel.add_row("Total Transferred:", format_bytes(total_transferred_bytes))
        success_panel.add_row("Elapsed Time:", format_duration(elapsed))
        success_panel.add_row("Average Speed:", f"[bold green]{format_bytes(avg_speed)}/s[/bold green]")
        if delete_source and not dry_run:
            success_panel.add_row("Source Cleanup:", "[bold green]✔ Freed up source storage safely[/bold green]")

        box_title = "[bold #a6e3a1]🎉 Camera Offload Finished[/bold #a6e3a1]" if camera_mode else "[bold #a6e3a1]🎉 Google Drive Backup Finished[/bold #a6e3a1]"
        console.print(Panel(success_panel, title=box_title, box=box.ROUNDED))
    else:
        console.print(f"[bold red]✖ Import finished with warnings or errors (exit code {overall_ret_code})[/bold red]")
        if errors_encountered:
            for err in errors_encountered[:5]:
                console.print(f"  [red]• {err}[/red]")
        return overall_ret_code

    # Optional post-import hash verification
    if verify and not dry_run and not delete_source and overall_ret_code == 0:
        console.print(f"\n[bold cyan]🔍 Running integrity check against Google Drive MD5 hashes...[/bold cyan]")
        for stage_name, target_remote, by_dir, _ in batches_queue:
            for d_src in by_dir.keys():
                chk_cmd = ["rclone", "check", d_src, target_remote, "--one-way"]
                chk_res = subprocess.run(chk_cmd, capture_output=True, text=True)
                if chk_res.returncode == 0:
                    console.print(f"[bold green]✔ [{stage_name}] All files verified bit-for-bit identical with remote![/bold green]")
                else:
                    console.print(f"[bold yellow]Verification notice for {stage_name}:[/bold yellow] {chk_res.stderr.strip()}")

    return 0


def main():
    ensure_sleep_inhibited()

    parser = argparse.ArgumentParser(
        prog="gdrive-import",
        description="High-throughput Google Drive Import & Camera Media Offload Tool.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Auto-detect camera card and offload photos (YYYY/MM/) and videos (YYYY/MM/videos/):
  gdrive-import --camera

  # Offload camera photos only:
  gdrive-import --camera --photos-only

  # Offload camera videos only:
  gdrive-import --camera --videos-only

  # Offload camera and safely free SD card storage after verified transfer:
  gdrive-import --camera --delete-source

  # Generic backup of any local directory to Google Drive:
  gdrive-import ~/Documents/Projects

  # Generic backup of a folder to a specific Google Drive target:
  gdrive-import ~/Pictures/Vacation "gdrive:Media/Backups/Vacation2026"

  # Test run without transferring or deleting (dry run):
  gdrive-import --camera --dry-run
""",
    )
    parser.add_argument(
        "source",
        nargs="?",
        default=None,
        help="Source directory, file, or camera mount point (in --camera mode, auto-detects SD card if omitted)",
    )
    parser.add_argument(
        "destination",
        nargs="?",
        default=None,
        help=f"Google Drive target folder (default: {DEFAULT_BASE_DEST}/<YYYY>/<MM> for --camera; Media/Backups/<name> for generic)",
    )
    parser.add_argument(
        "--camera",
        action="store_true",
        help="Activate specialized camera SD card offload mode (auto-detects SD card, splits photos/videos into YYYY/MM/ and YYYY/MM/videos/, flattens containers)",
    )
    parser.add_argument(
        "--photos-only",
        action="store_true",
        help="Offload only photo files from DCIM/ (specialized camera mode)",
    )
    parser.add_argument(
        "--videos-only",
        action="store_true",
        help="Offload only video files and paired XML sidecars (specialized camera mode)",
    )
    parser.add_argument(
        "--no-date-sort",
        "--flat",
        action="store_true",
        help="Do not sort camera media into YYYY/MM subdirectories; upload directly into destination folder",
    )
    parser.add_argument(
        "--delete-source",
        "--move",
        action="store_true",
        help="Safely delete local files from source ONLY after verified cloud upload",
    )
    parser.add_argument(
        "--ignore-existing",
        action="store_true",
        help="Skip any file that already exists on destination (never overwrite, regardless of content/size)",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Simulate the offload without transferring files or modifying source",
    )
    parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Skip interactive confirmation prompt",
    )
    parser.add_argument(
        "--verify",
        action="store_true",
        help="Perform post-upload hash integrity check against Google Drive",
    )
    parser.add_argument(
        "--chunk-size",
        default=DEFAULT_CHUNK_SIZE,
        help=f"Upload chunk size for media (default: {DEFAULT_CHUNK_SIZE})",
    )
    parser.add_argument(
        "--transfers",
        type=int,
        default=DEFAULT_TRANSFERS,
        help=f"Number of parallel file uploads (default: {DEFAULT_TRANSFERS})",
    )
    parser.add_argument(
        "--no-inhibit",
        action="store_true",
        help="Do not invoke systemd-inhibit to prevent system suspend",
    )

    args = parser.parse_args()

    is_camera_mode = args.camera or args.photos_only or args.videos_only

    source = args.source
    if is_camera_mode:
        if not source:
            candidates = detect_sd_cards()
            if not candidates:
                console.print("[bold yellow]No camera card or DCIM directories auto-detected.[/bold yellow]")
                source = Prompt.ask("Enter camera source folder path to import from")
            elif len(candidates) == 1:
                console.print(f"[bold green]Auto-detected camera media at:[/bold green] [cyan]{candidates[0]}[/cyan]")
                source = candidates[0]
            else:
                console.print("[bold cyan]Found multiple candidate media directories:[/bold cyan]")
                for idx, c in enumerate(candidates, 1):
                    console.print(f"  [{idx}] {c}")
                choice = Prompt.ask("Select directory number", choices=[str(i) for i in range(1, len(candidates) + 1)])
                source = candidates[int(choice) - 1]
    else:
        if not source:
            candidates = detect_sd_cards()
            if candidates:
                console.print(f"[bold yellow]Notice:[/bold yellow] Camera SD card detected at [cyan]{candidates[0]}[/cyan].")
                console.print("[dim]To run the specialized camera offload, launch with [bold cyan]gdrive-import --camera[/bold cyan][/dim]\n")
                ans = Prompt.ask("Enter source path to backup (or type 'camera' to use camera mode)", default="camera")
                if ans.strip().lower() == "camera":
                    is_camera_mode = True
                    source = candidates[0]
                else:
                    source = ans.strip()
            else:
                source = Prompt.ask("Enter source directory or file path to backup to Google Drive")

    if not args.yes and not args.dry_run:
        prompt_msg = "Proceed with camera offload to Google Drive?" if is_camera_mode else "Proceed with Google Drive backup?"
        if args.delete_source:
            prompt_msg = "[bold red]Proceed and DELETE source files after upload?[/bold red]"
        if not Confirm.ask(prompt_msg, default=True):
            console.print("[yellow]Operation canceled by user.[/yellow]")
            sys.exit(0)

    app_title = "gdrive-import [camera]" if is_camera_mode else "gdrive-import"
    set_terminal_title(app_title)

    try:
        code = run_import(
            source_path=source,
            dest_path=args.destination,
            chunk_size=args.chunk_size,
            transfers=args.transfers,
            delete_source=args.delete_source,
            dry_run=args.dry_run,
            verify=args.verify,
            ignore_existing=args.ignore_existing,
            camera_mode=is_camera_mode,
            sort_by_date=not args.no_date_sort,
            photos_only=args.photos_only,
            videos_only=args.videos_only,
        )
    finally:
        restore_terminal_title()

    sys.exit(code)


if __name__ == "__main__":
    main()
